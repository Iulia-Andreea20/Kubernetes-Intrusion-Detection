        <mxCell id="d1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5b6670;strokeWidth=1.6;" edge="1" parent="1" source="traffic" target="capture">
