        <mxCell id="benign" value="&lt;b&gt;TRAFIC NORMAL&lt;/b&gt;&lt;br&gt;permis, fără alertă" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dcefda;strokeColor=#3a8a3a;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
