{
  "uid": "ids-audit-xgb",
  "title": "Audit detector",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total alerts",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(audit_xgb_alerts_total)", "refId": "A" } ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Alerts in the last 2 min",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 } ] } } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "round(sum(increase(audit_xgb_alerts_total[2m])) or vector(0))", "refId": "A" } ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Predictions per minute (benign vs attack)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "round(sum by (verdict) (increase(audit_xgb_predictions_total[1m])))", "legendFormat": "{{verdict}}", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Alerts per minute (windows over threshold)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "round(sum(increase(audit_xgb_alerts_total[1m])))", "legendFormat": "alerts/min", "refId": "A" }
      ]
    }
  ]
}
