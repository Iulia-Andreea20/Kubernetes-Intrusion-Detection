{
  "uid": "falco-container",
  "title": "Falco – Container Level Detection",
  "tags": ["ids", "falco", "runtime"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Total runtime detections",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(falco_alerts_total) or vector(0)" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "red" }, "unit": "short" } }
    },
    {
      "id": 2, "type": "stat", "title": "Containers with detections",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "count(count by (pod) (falco_alerts_total)) or vector(0)" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "orange" }, "unit": "short" } }
    },
    {
      "id": 3, "type": "piechart", "title": "Detections by priority",
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (priority) (falco_alerts_total)", "legendFormat": "{{priority}}" }
      ]
    },
    {
      "id": 4, "type": "timeseries", "title": "Detections per minute, by rule",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "round(sum by (rule) (increase(falco_alerts_total[1m])))", "legendFormat": "{{rule}}" }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 60 } } }
    },
    {
      "id": 5, "type": "timeseries", "title": "Detections per minute, by pod",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "round(sum by (pod) (increase(falco_alerts_total[1m])))", "legendFormat": "{{pod}}" }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 60 } } }
    },
    {
      "id": 6, "type": "table", "title": "Container-level detections (pod, namespace, rule)",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (namespace, pod, rule, priority) (falco_alerts_total)",
          "format": "table", "instant": true }
      ],
      "transformations": [
        { "id": "organize", "options": {
            "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true },
            "renameByName": { "namespace": "Namespace", "pod": "Container/Pod", "rule": "Rule", "priority": "Priority", "Value": "Detections" }
        } }
      ]
    }
  ]
}
