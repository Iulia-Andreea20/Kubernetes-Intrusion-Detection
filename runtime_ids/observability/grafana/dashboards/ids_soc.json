    {
      "id": 4,
      "type": "timeseries",
      "title": "Predicții pe minut — benign vs atac (Audit + Flow) + atacuri Falco",
      "gridPos": {
        "h": 7,
        "w": 16,
        "x": 8,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "round(sum by (verdict) (increase(audit_xgb_predictions_total[1m]) or increase(runtime_ids_flow_predictions_total[1m])))",
          "legendFormat": "{{verdict}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "round(sum(increase(falco_alerts_total[1m])))",
          "legendFormat": "Falco (atac runtime)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "attack"
            },
            "properties": [
              {
                "id": "color",
                "value": {
