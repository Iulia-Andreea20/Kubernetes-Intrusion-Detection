  "rules": {
    "F_severity": "orice fereastra cu has_crb>=1 SAU has_exec>=1 SAU has_impersonation>=1 SAU (has_secret>=1 si secret_ns>=2)",
    "recon": "identitate NE-allowlistata cu n_selfreview>=5 pe fereastra",
    "destruct": "identitate NE-allowlistata cu n_delete>=5 pe fereastra",
    "hijack": "identitate NE-allowlistata cu n_create_workload>=1 pe fereastra",
    "persist": "identitate NE-allowlistata cu has_csr>=1 SAU has_tokenreq>=1 (CSR self-approve / TokenRequest abuse)",
    "anom": "identitate ALLOWLISTATA-prin-prefix dar NECUNOSCUTA (nu e in known_allow) cu rata privilegiata (n_delete>=5 SAU n_selfreview>=5 SAU n_create_workload>=1 SAU has_csr SAU has_tokenreq) -> SA fabricat in kube-system"
  },
  "alert_rule": "clasificator(prob>=0.5, K=2 ferestre) SAU F SAU recon SAU destruct SAU hijack SAU persist SAU anom",
