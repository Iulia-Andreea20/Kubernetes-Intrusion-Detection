# Imagine ușoară pentru adapter-ul de audit AKS (Log Analytics → IDS).
# Build din rădăcina repo-ului:
#   docker build -f runtime_ids/deploy/azure/Dockerfile.adapter -t ids-audit-adapter:2.3 .
FROM python:3.11-slim
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY runtime_ids/deploy/azure/requirements-adapter.txt /app/req.txt
RUN pip install --no-cache-dir -r /app/req.txt
COPY runtime_ids/deploy/azure/audit_loganalytics_adapter.py /app/adapter.py
CMD ["python", "adapter.py"]
